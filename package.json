{
  "name": "freelance-guy-github-io",
  "version": "0.0.1",
  "private": true,
  "description": "SiteMedic by Ziegfrid \u2014 Website Triage & Care",
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-app-vite",
    "quasar-cli",
    "vite",
    "vue",
    "vuejs"
  ],
  "author": "Ziegfrid Gualberto <ziegfrid.gualberto@gmail.com>",
  "type": "module",
  "scripts": {
    "lint": "oxfmt && oxlint --fix",
    "lint:check": "oxfmt --check && oxlint",
    "dev": "quasar dev",
    "build": "quasar build",
    "build:ssg": "quasar build -m ssg",
    "deploy": "quasar build -m ssg && gh-pages -d dist/ssg --dotfiles",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "quasar": "^2.35.1",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.10.2",
    "@types/node": "^22.19.11",
    "autoprefixer": "^10.4.27",
    "gh-pages": "^6.3.0",
    "oxfmt": "^0.x",
    "oxlint": "^1.x",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.8",
    "typescript": "^6.0.0",
    "vue-tsc": "^3.3.3"
  },
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  },
  "productName": "SiteMedic by Ziegfrid"
}
